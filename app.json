{
  "expo": {
    "name": "MealsApp",
    "slug": "MealsApp",
    "privacy": "public",
    "sdkVersion": "36.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 5000
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zenithmanuel.mealsapp",
      "buildNumber": "1.0.0"
    },
    "android": {
      "versionCode": 1,
      "package": "com.zenithmanuel.mealsapp"
    }
  }
}
